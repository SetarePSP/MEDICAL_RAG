# === LLM (Gemini) ===
# Create at: https://aistudio.google.com/app/apikey
# Or via gcloud: gcloud services api-keys create --project=YOUR_PROJECT --api-target=service=generativelanguage.googleapis.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash

# === Embeddings (Vertex AI) ===
# Requires: gcloud auth application-default login
# GCP console: enable "Vertex AI API", grant "Vertex AI User" IAM role to your account
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-004

# === Supabase ===
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === Google Places (optional, for address enrichment) ===
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# === Stripe (optional, for real payment flow) ===
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CURRENCY=eur

# === Voice input (optional) ===
# Requires: brew install ffmpeg
WHISPER_MODEL=base

# === LangSmith LLM Observability (optional but recommended) ===
# Sign up at: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=medical-rag

# === Sentry Error Tracking (optional but recommended) ===
# Create project at: https://sentry.io → Projects → Create Project (FastAPI)
SENTRY_DSN=your-sentry-dsn
