# Copy this file to .env (same folder) and replace every placeholder with your real values.
# Never commit .env — it is listed in .gitignore.

# === LLM (Gemini) ===
# Create at: https://aistudio.google.com/app/apikey
# Or via gcloud: gcloud services api-keys create --project=YOUR_PROJECT --api-target=service=generativelanguage.googleapis.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash

# === Embeddings (Vertex AI) ===
# Requires: gcloud auth application-default login
# GCP console: enable "Vertex AI API", grant "Vertex AI User" IAM role to your account
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-004

# === Supabase ===
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === Google Places (optional, for address enrichment) ===
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# === Stripe (optional, for real payment flow) ===
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CURRENCY=eur

# === OpenAI Text-to-Speech (optional — speaker in the app header) ===
# 1. Create a key: https://platform.openai.com/api-keys
# 2. Copy this file to .env and paste your real key below (same pattern as GEMINI_API_KEY).
# 3. Billing must be enabled on your OpenAI account for TTS (pay per character).
# If you leave OPENAI_API_KEY empty, the speaker button stays disabled.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# 0.25–4.0; slightly above 1.0 sounds a bit faster (less “slow”)
OPENAI_TTS_SPEED=1.12

# === Voice input (optional) ===
# Requires: brew install ffmpeg
# Local dev: base is fine. Cloud Run: use tiny + ≥2Gi memory (Whisper + PyTorch are heavy).
WHISPER_MODEL=base
# Optional: force language (it, en) or leave unset for auto-detect. task=translate → English text only.
# WHISPER_LANGUAGE=
# WHISPER_TASK=transcribe

# === LangSmith LLM Observability (optional but recommended) ===
# Sign up at: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=medical-rag

# === Sentry Error Tracking (optional but recommended) ===
# Create project at: https://sentry.io → Projects → Create Project (FastAPI)
SENTRY_DSN=your-sentry-dsn
